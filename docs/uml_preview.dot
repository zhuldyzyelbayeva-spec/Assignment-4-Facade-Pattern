digraph G { graph [rankdir=LR, bgcolor="white", pad="0.3"]; node [shape=record, fontname="DejaVu Sans", fontsize=11]; Main [label="Main (Client)"]; OrderFacade [label="{OrderFacade|+ placeOrder(cart, customer)\l+ availableStock(productId)\l}"]; InventoryService [label="{InventoryService|+ reserve(cart)\l+ release(cart)\l}"]; PaymentProcessor [label="{PaymentProcessor|+ charge(customer, amount)\l+ refund(paymentId)\l}"]; ShippingService [label="{ShippingService|+ schedule(customer, cart)\l+ cancel(shipmentId)\l}"]; NotificationService [label="{NotificationService|+ sendConfirmation(customer, orderId)\l}"]; Main -> OrderFacade; OrderFacade -> InventoryService; OrderFacade -> PaymentProcessor; OrderFacade -> ShippingService; OrderFacade -> NotificationService; }